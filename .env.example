# Privora — copy to .env.local. No secrets are required; every variable is public config.

# Chain the Uniswap V2 interface reads from: 11155111 (Sepolia, default) or 1 (Ethereum mainnet)
NEXT_PUBLIC_CHAIN_ID=11155111

# Public JSON-RPC used for (a) Standard RPC mode and (b) the exit node's fetch in Anon-RPC mode.
# Optional overrides; defaults are keyless publicnode endpoints.
NEXT_PUBLIC_RPC_URL_SEPOLIA=
NEXT_PUBLIC_RPC_URL_MAINNET=

# Anon-RPC network: nox | tor-js | nym   (passthrough is never allowed in Anon-RPC mode)
NEXT_PUBLIC_ANON_RPC_NETWORK=nox
